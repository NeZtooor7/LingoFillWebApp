# Copy this file to .env and replace the password and secret placeholders.
# Docker Compose and Django share these database settings.
DB_NAME=lingofill
DB_USER=lingofill_user
DB_PASSWORD=replace-with-your-local-database-password
# Django runs on your computer; the Docker database publishes this host port.
DB_HOST=127.0.0.1
DB_PORT=5434
# For a native PostgreSQL installation, use its actual connection settings
# (usually DB_PORT=5432). PostgreSQL inside the container always uses port 5432.
# Database name, user and password initialize an empty Docker volume only.
# Editing them here does not update an already initialized database.

# Existing Django configuration.
EXERCISE_SIGNING_SALT=put-your-random-value-here
DJANGO_SECRET_KEY=django-insecure-local-dev-only-change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1

# OpenAI configuration for AI generation and explanations.
OPENAI_API_KEY=your-real-api-key-here
OPENAI_GENERATION_MODEL=gpt-5-nano
OPENAI_CORRECTION_MODEL=gpt-5-mini
OPENAI_TIMEOUT_SECONDS=45
